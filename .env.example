# Skaner (laptop). Aplikacja ma własne zmienne w webapp/.env.example
OCRM_CONFIG=config.yaml
OCRM_DB=data/ocrm.db

# Dokąd skaner wysyła dane (adres z Vercela) i czym się autoryzuje.
# INGEST_TOKEN musi być identyczny jak zmienna INGEST_TOKEN w projekcie na Vercelu.
OCRM_APP_URL=https://twoj-projekt.vercel.app
INGEST_TOKEN=
